#!/bin/sh /etc/mk.rc.common

EXTRA_COMMANDS="setup_zone remove_zone repair_arp"
EXTRA_HELP="$(printf '\tsetup_zone\t开启防火墙
\tremove_zone\t重置/删除防火墙规则')"

PROG="/opt/bin/zerotier-one"

start_service() {
    if ! inspect_entware; then
        logerr "Entware 服务未安装或未运行！"
        return 1
    fi
    if [ ! -x "$PROG" ]; then
        logerr "未找到 zerotier-one 可执行程序！"
        return 1
    fi

    procd_open_instance
    procd_set_param command $PROG "$APP_DATA_DIR"
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
    repair_arp
}

repair_arp() {
    (
        sleep 3
        for dev in $(find /sys/class/net -name "zt*" -exec basename {} \;); do
            ip link set dev "$dev" arp on
            loginfo -s "已自动修复网卡 $dev 的 ARP 协议"
        done
    ) &
}

post_install(){
    if ! inspect_entware; then
        logerr "Entware 服务未安装或未运行！"
        logerr "需要安装并运行 Entware 服务再进行重装应用！"
        return 1
    fi
    opkg update && opkg install zerotier
}

pre_uninstall() {
    opkg remove zerotier
    remove_zone
}

