#    iptables -I FORWARD -i zt+ -o br-lan -j ACCEPT
#    iptables -D FORWARD -i br-lan -o zt+ -j ACCEPT 2>/dev/null
#    iptables -I FORWARD -i br-lan -o zt+ -j ACCEPT


setup_zone() {
    uci set firewall.zerotier=zone
    uci set firewall.zerotier.name='zerotier'
    uci set firewall.zerotier.input='ACCEPT'
    uci set firewall.zerotier.output='ACCEPT'
    uci set firewall.zerotier.forward='ACCEPT'
    #uci set firewall.zerotier.masq='1'                   # Export NAT 开启地址伪装 (MASQUERADE)
    uci del firewall.zerotier.device 2>/dev/null
    uci add_list firewall.zerotier.device="zt+"
    uci del firewall.zerotier.match_devices 2>/dev/null
    uci set firewall.zerotier.match_devices='zt+'

    # 建立 ZeroTier -> LAN 的区域转发 (Forwarding)
    uci set firewall.zerotier_to_lan=forwarding
    uci set firewall.zerotier_to_lan.src='zerotier'
    uci set firewall.zerotier_to_lan.dest='lan'

    # 建立 LAN -> ZeroTier 的区域转发 (Forwarding)
    uci set firewall.lan_to_zerotier=forwarding
    uci set firewall.lan_to_zerotier.src='lan'
    uci set firewall.lan_to_zerotier.dest='zerotier'
    uci commit firewall
    /etc/init.d/firewall reload >/dev/null 2>&1
}

remove_zone() {
    uci del firewall.zerotier 2>/dev/null
    uci del firewall.zerotier_to_lan 2>/dev/null
    uci del firewall.lan_to_zerotier 2>/dev/null
    uci commit firewall
    /etc/init.d/firewall reload >/dev/null 2>&1
}