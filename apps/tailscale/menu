#!/bin/sh /etc/mk.menu.common

OPTIONS="\
网络状态与节点信息:ts_status|\
登录/切换账号(Up/Login):ts_login|\
登出/断开网络(Logout):ts_logout|\
对等节点列表(Peers):ts_peers|\
子网路由与Exit Node配置:ts_routes|\
防火墙转发规则管理:ts_firewall_menu"

refresh() { [ "$APP_STATUS" = "1" ] && APP_EXTRA_INFO=$(get_ts_info) || APP_EXTRA_INFO="";  }

# 重写 (Override) 覆盖基础方法   避免 tailscaled 网卡 停止太久卡顿菜单操作  停止服务优化：秒杀进程以提升菜单响应速度
stop() {
    echo " 🛑 正在停止服务..."
    killall -9 tailscaled 2>/dev/null
    "$APP_SCRIPT" stop
    echo -e "\n ✅ 操作完成"
}

# 获取 Tailscale 本地 IP 与运行状态摘要
get_ts_info() {
    local ip
    ip=$(tailscale ip -4 2>/dev/null)
    if [ -n "$ip" ]; then
        echo " IP: $ip"
    else
        echo " 未连接 / 未授权"
    fi
}

# 1. 查看网络状态与分配的虚拟 IP
ts_status() {
    echo " 📊 【Tailscale 运行状态与接口】"

    if [ "$APP_STATUS" != "1" ]; then
        echo -e "\n 🔴 服务状态: Tailscale 未运行 (服务已停止)"
        echo -e " 💡 提示: 请先启动 Tailscale 服务后再查看状态。"
        return 0
    fi

    echo -e "\n--- 本地节点与连接状态 ---"
    if ! tailscale status 2>/dev/null; then
        return 1
    fi

    echo -e "\n--- IPv4 / IPv6 地址 ---"
    tailscale ip 2>/dev/null || echo "未获取到 IP 地址"
}

# 2. 登录 / 启动并绑定 Tailscale 网络
ts_login() {
    echo -e "\n 🌐 【登录 / 挂载 Tailscale 网络】"
    echo " 1) 使用一次性 Key 登录 (AuthKey)"
    echo " 2) 生成 URL 交互登录 (Web Login)"
    read -r -p "请选择操作 [1-2]: " choice

    case "$choice" in
        1)
            read -r -p "请输入 Auth Key (tskey-auth-...): " auth_key
            auth_key=$(echo "$auth_key" | tr -d ' \r\n')
            if [ -z "$auth_key" ]; then
                echo -e "\n ❌ 错误: Auth Key 不能为空！"
                return 1
            fi
            echo " ⏳ 正在使用 Key 登录 Tailscale ..."
            if tailscale up --authkey="$auth_key" --accept-dns=false 2>&1; then
                echo -e "\n ✅ 成功加入 Tailscale 网络！"
            else
                echo -e "\n ❌ 登录失败，请检查 Key 是否有效。"
            fi
            ;;
        2)
            echo " ⏳ 正在获取登录 URL，请复制并在浏览器中打开完成授权..."
            tailscale up --accept-dns=false
            ;;
        *)
            echo -e "\n ❗ 无效选项"
            ;;
    esac
}

# 3. 登出 / 断开网络
ts_logout() {
    echo -e "\n 🚪 【断开 / 登出 Tailscale 网络】"
    read -r -p "确定要登出当前账号并断开连接吗？(y/N): " confirm
    case "$confirm" in
        [yY][eE][sS]|[yY])
            echo " ⏳ 正在执行登出操作..."
            tailscale logout
            echo -e "\n ✅ 已安全登出节点！"
            ;;
        *)
            echo "已取消操作。"
            ;;
    esac
}

# 4. 查看对等节点列表 (Peers)
ts_peers() {
    echo " 🔍 【对等节点 (Peers) 与连接状态】"
    tailscale status --peers
}

# 5. 广播本地子网路由 (Subnet Router) 与 Exit Node 配置
ts_routes() {
    echo -e "\n 🛣️ 【子网路由与 Exit Node 管理】"
    echo " 1) 广播当前 LAN 网段 (Subnet Router)"
    echo " 2) 开启/关闭 Exit Node 节点功能"
    echo " 3) 取消所有子网广播"
    read -r -p "请选择操作 [1-3]: " choice

    case "$choice" in
        1)
            local lan_ip lan_net
            lan_ip=$(uci get network.lan.ipaddr 2>/dev/null || echo "192.168.1.1")
            lan_net="$(echo "$lan_ip" | cut -d. -f1-3).0/24"

            read -r -p "请输入要广播的子网 CIDR [默认 $lan_net]: " input_net
            input_net="${input_net:-$lan_net}"

            echo " ⏳ 正在广播子网 [$input_net] ..."
            tailscale up --advertise-routes="$input_net" --accept-dns=false
            echo -e "\n ✅ 子网路由请求已提交！"
            echo " 💡 提示: 请务必前往 Tailscale 控制台 (Admin Console) 的 Edit route settings 手动 Approved 激活此路由。"
            ;;
        2)
            echo " 1) 设置本路由为 Exit Node (出口节点)"
            echo " 2) 关闭 Exit Node 功能"
            read -r -p "请选择 [1-2]: " en_choice
            if [ "$en_choice" = "1" ]; then
                tailscale up --advertise-exit-node --accept-dns=false
                echo -e "\n ✅ 已提交出口节点广播！请至控制台批准该设置。"
            else
                tailscale up --advertise-exit-node=false --accept-dns=false
                echo -e "\n ✅ 出口节点功能已关闭。"
            fi
            ;;
        3)
            echo " ⏳ 正在取消所有子网广播..."
            tailscale up --advertise-routes="" --accept-dns=false
            echo -e "\n ✅ 已清空路由广播。"
            ;;
        *)
            echo -e "\n ❗ 无效选项"
            ;;
    esac
}

# 6. 防火墙转发与 NAT 伪装管理
ts_firewall_menu() {
    local is_forward is_masq f_status m_status
    is_forward=$(uci get firewall.tailscale 2>/dev/null)
    is_masq=$(uci get firewall.tailscale.masq 2>/dev/null)

    [ "$is_forward" = "zone" ] && f_status="\e[1;32m已启用\e[0m" || f_status="\e[1;31m未启用\e[0m"
    [ "$is_masq" = "1" ] && m_status="\e[1;32m已开启\e[0m" || m_status="\e[1;33m已关闭\e[0m"

    echo -e "\n 🧱 Tailscale 防火墙转发规则管理"
    echo -e "   当前双向转发状态: [$f_status]"
    echo -e "   当前地址伪装(NAT): [$m_status]"
    echo "-------------------------------------------"
    echo " 1) 开启双向转发规则 (建立 Zone)"
    echo " 2) 关闭/清理转发规则"
    echo " 3) 开关 NAT 地址伪装 (MASQ)"
    read -r -p "请选择操作 [1-3]: " choice

    case "$choice" in
        1)
            echo -e "\n ⏳ 正在配置完整互通规则..."
            "$APP_SCRIPT" setup_zone
            echo -e "\n ✅ 完整互通规则已生效！"
            ;;
        2)
            echo -e "\n ⏳ 正在清理 Tailscale 所有防火墙规则..."
            "$APP_SCRIPT" remove_zone
            echo -e "\n ✅ 已成功卸载 Tailscale 防火墙规则！"
            ;;
        3)
            if [ "$is_forward" != "zone" ] ; then
                echo " ❌ 请先开启转发规则 ..."
                return 1
            elif [ "$is_masq" = "1" ]; then
                echo " ⏳ 正在关闭地址伪装 (MASQ) ..."
                uci set firewall.tailscale.masq='0'
                echo -e "\n ✅ MASQ 地址伪装已关闭！"
            else
                echo " ⏳ 正在开启地址伪装 (MASQ) ..."
                uci set firewall.tailscale.masq='1'
                echo -e "\n ✅ MASQ 地址伪装已开启！"
            fi
            uci commit firewall
            /etc/init.d/firewall reload >/dev/null 2>&1
            ;;
        *)
            echo -e "\n ❗ 无效选项"
            ;;
    esac
}