#!/bin/sh
. $IPKG_INSTROOT/lib/functions.sh
. $IPKG_INSTROOT/lib/functions/service.sh
. $MIKIT_DIR/core/env.sh

initscript="$1"
action="${2:-help}"
shift 2

if [ -z "$initscript" ] || [ ! -f "$initscript" ]; then
    logerr "❌ 错误: 未找到控制脚本 -> '$initscript'"
    exit 1
fi

help() {
        cat <<EOF
Syntax: $initscript [command]

Available commands:
        status  Show service status
        start   Start the service
        stop    Stop the service
        restart Restart the service
$EXTRA_HELP
EOF
}

post_install()     { return 0; }
pre_uninstall()    { return 0; }
start_service()    { return 0; }
start_later()      { return 0; }
stop_service()     { return 0; }
stop_later()       { return 0; }
restart()          { stop "$@"; start "$@"; }

service_triggers() { return 0; }
service_data()     { return 0; }
APP_DIR="$(dirname "$initscript")"
APP_ID="$(basename "$APP_DIR")"
APP_DATA_DIR="$MIKIT_DATA_DIR/apps_data/$APP_ID"

. "$initscript"

if [ -f /lib/functions/procd.sh ] && [ -x /sbin/procd ]; then
    # =========================================================
    # 1. 真实 procd 环境 (OpenWrt >= 14.07)
    # =========================================================

    . $IPKG_INSTROOT/lib/functions/procd.sh

    # OpenWrt procd 服务名严格等于 init 脚本本身的 basename
    service_name="$(basename "$initscript")"

    rc_procd() {
        local method="set"
        [ -n "$2" ] && method="add"
        procd_open_service "$service_name" "$initscript"
        "$@"
        procd_close_service "$method"
    }

    start() {
        rc_procd start_service "$@"
        start_later "$@"
    }

    stop() {
        procd_lock
        stop_service "$@"
        procd_kill "$service_name" "$1" 2>/dev/null
        procd_unlock
        stop_later "$@"
    }

    status() {
        if command -v service_running >/dev/null 2>&1; then
            service_running "$@"
            return $?
        fi

        local ubus_out
        ubus_out=$(ubus call service list "{\"name\": \"$service_name\"}" 2>/dev/null)

        local pid=""

        if command -v jsonfilter >/dev/null 2>&1; then
            pid=$(echo "$ubus_out" | jsonfilter -e "@['$service_name'].instances.*.pid" 2>/dev/null | head -n 1)
        fi

        if [ -z "$pid" ] && [ -n "$ubus_out" ]; then
            pid=$(echo "$ubus_out" | grep -o '"pid":[0-9]*' | head -n 1 | cut -d':' -f2)
        fi

        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "status=running pid=$pid"
            return 0
        fi

        local search_prog="${PROG:-$APP_ID}"
        if [ -n "$search_prog" ]; then
            local prog_name="${search_prog##*/}"
            local prog_pid
            prog_pid=$(pgrep -x "$prog_name" 2>/dev/null | head -n 1)
            [ -z "$prog_pid" ] && prog_pid=$(pgrep -f "$search_prog" 2>/dev/null | head -n 1)

            if [ -n "$prog_pid" ]; then
                echo "status=running pid=$prog_pid"
                return 0
            fi
        fi

        echo "status=stopped pid=0"
        return 1
    }
else
    # =========================================================
    # 2. 传统/老旧环境 procd API 降级
    # =========================================================
    _PROCD_CMD=""
    _PROCD_PIDFILE="/var/run/${APP_ID}.pid"
    procd_open_instance() { return 0; }

    procd_set_param() {
        local type="$1"
        shift
        _PROCD_PIDFILE="/var/run/${APP_ID}.pid"
        case "$type" in
        command)
            _PROCD_ALL_COMMANDS="$*"
            _PROCD_CMD="${_PROCD_ALL_COMMANDS%% *}"

            case "$_PROCD_ALL_COMMANDS" in
            *" "*) _PROCD_ARGS="${_PROCD_ALL_COMMANDS#* }" ;;
            esac
        ;;
        env)
            while [ $# -gt 0 ]; do
                export "$1"
                shift
            done
        ;;
        esac
    }

    procd_param_verify() {
        if [ -z "$_PROCD_ALL_COMMANDS" ]; then
            logerr "❌ 'command' 参数为空"
            return 1
        fi
        if [ ! -x "$_PROCD_CMD" ] && ! command -v "$_PROCD_CMD" >/dev/null 2>&1; then
            logerr "❌ 找不到可执行程序 '$_PROCD_CMD'"
            return 1
        fi
        return 0
    }

    procd_close_instance() {
        procd_param_verify || return 1
        if [ -n "$_PROCD_ARGS" ]; then
            start-stop-daemon -S -b -m -p "$_PROCD_PIDFILE" -x "$_PROCD_CMD" -- $_PROCD_ARGS >/dev/null 2>&1
        else
            start-stop-daemon -S -b -m -p "$_PROCD_PIDFILE" -x "$_PROCD_CMD" >/dev/null 2>&1
        fi
        return $?
    }

    start() {
        start_service "$@" || return 1
        start_later "$@"
    }

    stop() {
        stop_service "$@"
        if [ -f "$_PROCD_PIDFILE" ]; then
            start-stop-daemon -K -p "$_PROCD_PIDFILE" >/dev/null 2>&1
            rm -f "$_PROCD_PIDFILE"
        fi
        stop_later "$@"
    }

    status() {
        if command -v service_running >/dev/null 2>&1; then
            service_running "$@"
            return $?
        fi

        if [ -s "$_PROCD_PIDFILE" ]; then
            local file_pid
            read -r file_pid < "$_PROCD_PIDFILE" 2>/dev/null
            if [ -n "$file_pid" ] && kill -0 "$file_pid" 2>/dev/null; then
                echo "status=running pid=$file_pid"
                return 0
            fi
        fi

        echo "status=stopped pid=0"
        return 1
    }
fi

ALL_COMMANDS="start stop restart status post_install pre_uninstall ${EXTRA_COMMANDS}"
list_contains ALL_COMMANDS "$action" || action=help
$action "$@"