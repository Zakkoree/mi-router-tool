# 📄 查看应用运行日志
custom_logs() {
    local log_file="$APP_DATA_DIR/heartbeat.log"
    echo ""
    echo "=================== 📄 $APP_NAME 运行日志 ==================="
    if [ -f "$log_file" ]; then
        tail -n 10 "$log_file"
    else
        echo "❗ 暂未检测到日志文件: $log_file"
    fi
}

# 🔧 修改配置文件
custom_config() {
    local config_file="$APP_DATA_DIR/config.conf"
    echo ""
    echo "--- 🔧 修改 $APP_NAME 配置 ---"
    if [ -f "$config_file" ]; then
        if command -v vi >/dev/null 2>&1; then
            vi "$config_file"
        else
            echo "❗ 未找到 vi 编辑器，请手动修改文件: $config_file"
        fi
    else
        echo "❗ 配置文件不存在: $config_file"
    fi
}