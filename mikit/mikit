            9) toolkit_uninstall ;;
            0) break ;;
            *)
                echo -e "\n ❌ 无效选项，请重新输入！"
                pause
                ;;
        esac
    done
}

# https://cdn.jsdelivr.net/gh/maxiaof/github-hosts/hosts
set_download_mirror() {
    # 1. 预设镜像源集合 (格式: "显示名称|URL前缀")
    # 扩展时只需在此处按格式新增一行即可
    local mirrors_def="
ghproxy.net|https://ghproxy.net/
mirror.mikus.ink|https://mirror.mikus.ink/
gh.996986.xyz|https://gh.996986.xyz/
wget.la|https://wget.la/
"
    local last_count=0
    while true; do
        clear
        main_line
        print_center "🌐 设置 GitHub 下载镜像源" 8
        echo -e "  当前使用的镜像源: ${MIRROR:-直连 (官方原源)}"
        sub_line

        echo -e "  ${C_GREEN}1)${C_RESET} 🐙 直连 (GitHub 官方原源)"

        if [ "$last_count" -gt 0 ]; then
            local i=1
            while [ $i -le "$last_count" ]; do
                unset "MIRROR_URL_${i}"
                unset "MIRROR_NAME_${i}"
                i=$((i + 1))
            done
        fi

        local idx=2
        for item in $mirrors_def; do
            [ -z "$item" ] && continue
            local m_name="${item%%|*}"
            local m_url="${item#*|}"

            echo -e "  ${C_GREEN}${idx})${C_RESET} 🔗 ${m_name}"
            eval "MIRROR_URL_${idx}=\"$m_url\""
            eval "MIRROR_NAME_${idx}=\"$m_name\""
            idx=$((idx + 1))
        done
        last_count=$idx

        local custom_idx=$idx
        echo -e "  ${C_GREEN}${custom_idx})${C_RESET} 📝 手动输入自定义镜像 URL"

        sub_line
        echo -e "  ${C_GRAY}0)${C_RESET} 🔙  返回"
        main_line
        printf " 👉 请选择 [${C_BOLD}0-${custom_idx}${C_RESET}]: "
        read m_choice

        # 3. 分支逻辑处理
        if [ "$m_choice" = "0" ]; then
            break
        elif [ "$m_choice" = "1" ]; then
            mikit_db set "mirror" ""
            MIRROR=""
            echo -e "\n ✅ 已切换为官方直连！"
            pause
            break
        elif [ "$m_choice" = "$custom_idx" ]; then
            echo ""
            echo -e " 💡 提示: 请输入完整的前缀 URL (例如: ${C_BLUE}https://gh.proxy.com/${C_RESET})"
            printf " 🔗 请输入自定义镜像源地址: "
            read custom_mirror

            if [ -z "$custom_mirror" ]; then
                echo -e "\n ${C_YELLOW}❌ 输入为空，已取消设置！${C_RESET}"
                pause
            else
                mikit_db set "mirror" "$custom_mirror"
                MIRROR="$custom_mirror"
                echo -e "\n ✅ 已成功设置自定义镜像: ${custom_mirror}"
                pause
                break
            fi
        else
            eval "local target_url=\$MIRROR_URL_${m_choice}"
            eval "local target_name=\$MIRROR_NAME_${m_choice}"

            if [ -n "$target_url" ]; then
                mikit_db set "mirror" "$target_url"
                MIRROR="$target_url"
                echo -e "\n ✅ 已成功设置为 ${target_name} 镜像！${C_RESET}"
                pause
                break
            else
                echo -e "\n ❌ 输入无效，请重新选择！"
                pause
            fi
        fi
    done
}

