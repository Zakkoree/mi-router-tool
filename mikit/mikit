        echo -e "  ${C_RED}9)${C_RESET} 💥 卸载工具"
        echo -e "  ${C_GRAY}0)${C_RESET} 🔙 返回"
        main_line
        printf " 👉 请选择 [${C_BOLD}0-9${C_RESET}]: "
        read store_choice

        case "$store_choice" in
            1) toolkit_self_update ;;
            2) set_download_mirror ;;
            3) create_new_app ;;
            4)
              local logs="$(grep " mikit" /tmp/messages 2>/dev/null | tail -n 100)"

              if [ -n "$logs" ]; then
                  echo "$logs"
